<?xml version="1.0" encoding="utf-8"?>
<!--
  Tela principal. ScrollView para caber em celulares pequenos/antigos.
  Cada View com android:id vira uma propriedade em ActivityMainBinding (ViewBinding):
  @+id/startStopButton → binding.startStopButton
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:title="@string/app_name" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/phaseText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/messageText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/insecureWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/insecure_warning"
                    android:textColor="@color/status_warn"
                    android:visibility="gone" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:columnCount="2"
                    android:useDefaultMargins="true">

                    <TextView android:text="@string/label_endpoint" android:textStyle="bold" />
                    <TextView android:id="@+id/endpointText" android:layout_width="0dp"
                        android:layout_gravity="fill_horizontal" android:layout_columnWeight="1" />

                    <TextView android:text="@string/label_bitrate" android:textStyle="bold" />
                    <TextView android:id="@+id/bitrateText" />

                    <TextView android:text="@string/label_battery" android:textStyle="bold" />
                    <TextView android:id="@+id/batteryText" />

                    <TextView android:text="@string/label_temperature" android:textStyle="bold" />
                    <TextView android:id="@+id/temperatureText" android:layout_width="0dp"
                        android:layout_gravity="fill_horizontal" android:layout_columnWeight="1" />
                </GridLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/startStopButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/action_start" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settingsButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_settings" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/setup_title"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/batteryOptButton"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_battery_optimization" />

        <TextView
            android:id="@+id/overlayExplain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/overlay_explain" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/overlayButton"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_overlay" />

        <TextView
            android:id="@+id/setupDoneText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/setup_all_done"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
